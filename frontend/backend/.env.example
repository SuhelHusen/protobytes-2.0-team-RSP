# Hosted Postgres recommended (Supabase/Neon with pgvector enabled)
# Example: postgresql://user:pass@host:5432/studyplanner?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/studyplanner?sslmode=require
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
