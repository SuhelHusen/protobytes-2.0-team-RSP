# Hosted Postgres recommended (Supabase/Neon with pgvector enabled)
# Example: postgresql://user:pass@host:5432/studyplanner?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/studyplanner?sslmode=require
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
# Dev auth fallback (recommended in local hackathon demos when Postgres is offline)
ENABLE_DEV_AUTH_FALLBACK=true
DEV_FALLBACK_EMAIL=admin@gmail.com
DEV_FALLBACK_PASSWORD=secret123
DEV_FALLBACK_NAME=Demo User
DEV_FALLBACK_STREAM=SEE
# AI_PROVIDER options: ollama | openai | gemini | auto | mock
AI_PROVIDER=gemini
# Ollama (local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
